{
  "compilerOptions": {
    "target": "ES2019",
  "module": "CommonJS",
    "declaration": false,
  "outDir": "./dist",
  "strict": true,
  "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "manifest.json"]
}
